+			if (eDeviceClass == vr::TrackedDeviceClass_TrackingReference) {
+				CTX_INFO("Found lighthouse base station after setup: %s", pchDeviceSerialNumber);
+				return false;
+			}
 			// devices appearing after setup are not added to xrt_system_devices and would be leaked on
 			// exit
-			CTX_WARN("Cannot add device after setup; consider increasing LH_DISCOVER_WAIT_MS");
+			CTX_WARN("Cannot add device after setup (%s, class %u); consider increasing LH_DISCOVER_WAIT_MS",
+			         pchDeviceSerialNumber, (unsigned)eDeviceClass);
 			return false;
 		}
 
