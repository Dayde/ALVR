+/*
+ *
+ * B3-W1 local patch: controller stand-ins.
+ *
+ */
+
+PlaceholderController::PlaceholderController(const std::shared_ptr<Context> &p_ctx, xrt_hand p_hand)
+    : xrt_device({}), hand(p_hand), ctx(p_ctx)
+{
+	const InputClass &index = controller_classes.at("index_controller");
+	const bool left = hand == XRT_HAND_LEFT;
+
+	this->name = index.name;
+	this->device_type = left ? XRT_DEVICE_TYPE_LEFT_HAND_CONTROLLER : XRT_DEVICE_TYPE_RIGHT_HAND_CONTROLLER;
+	std::snprintf(this->str, sizeof(this->str), "Valve Knuckles %s (stand-in)", left ? "Left" : "Right");
+	std::snprintf(this->serial, sizeof(this->serial), "stand-in-%s", left ? "left" : "right");
+	this->tracking_origin = ctx.get();
+
+	// The same inputs a real Index controller ends up with, hand tracking included
+	inputs_vec.reserve(index.poses.size() + index.non_poses.size() + 1);
+	for (xrt_input_name input : index.poses) {
+		inputs_vec.push_back({true, 0, input, {}});
+	}
+	for (const auto &[path, input] : index.non_poses) {
+		inputs_vec.push_back({true, 0, input, {}});
+	}
+	inputs_vec.push_back({true, 0, left ? XRT_INPUT_HT_CONFORMING_LEFT : XRT_INPUT_HT_CONFORMING_RIGHT, {}});
+	this->inputs = inputs_vec.data();
+	this->input_count = inputs_vec.size();
+	target_index.assign(inputs_vec.size(), -1);
+
+	output.name = XRT_OUTPUT_NAME_INDEX_HAPTIC;
+	this->outputs = &output;
+	this->output_count = 1;
+
+	this->supported.orientation_tracking = true;
+	this->supported.position_tracking = true;
+	this->supported.hand_tracking = true;
+	this->supported.battery_status = true;
+
+	u_device_populate_function_pointers(this, get_tracked_pose_cb, destroy_cb);
+	this->update_inputs = update_inputs_cb;
+	this->get_hand_tracking = get_hand_tracking_cb;
+	this->set_output = set_output_cb;
+	this->get_battery_status = get_battery_status_cb;
+}
+
+bool
+PlaceholderController::bind(ControllerDevice *controller)
+{
+	if (get_target() != nullptr) {
+		return false;
+	}
+	target.store(controller, std::memory_order_release);
+	U_LOG_IFL_I(ctx->log_level, "Controller %s connected to the %s stand-in", controller->serial,
+	            hand == XRT_HAND_LEFT ? "left" : "right");
+	return true;
+}
+
+xrt_result_t
+PlaceholderController::update_inputs_cb(xrt_device *xdev)
+{
+	auto *self = static_cast<PlaceholderController *>(xdev);
+	ControllerDevice *t = self->get_target();
+	if (t == nullptr) {
+		return XRT_SUCCESS;
+	}
+	// The target's inputs can still grow (hand tracking is added once its skeleton arrives), so an
+	// input not found yet is looked up again on the next update.
+	for (size_t i = 0; i < self->inputs_vec.size(); i++) {
+		int idx = self->target_index[i];
+		if (idx < 0 || (size_t)idx >= t->input_count || t->inputs[idx].name != self->inputs_vec[i].name) {
+			idx = -1;
+			for (size_t j = 0; j < t->input_count; j++) {
+				if (t->inputs[j].name == self->inputs_vec[i].name) {
+					idx = (int)j;
+					break;
+				}
+			}
+			self->target_index[i] = idx;
+		}
+		if (idx >= 0) {
+			const xrt_input &src = t->inputs[idx];
+			self->inputs_vec[i].active = src.active;
+			self->inputs_vec[i].timestamp = src.timestamp;
+			self->inputs_vec[i].value = src.value;
+		}
+	}
+	return XRT_SUCCESS;
+}
+
+xrt_result_t
+PlaceholderController::get_tracked_pose_cb(xrt_device *xdev,
+                                           xrt_input_name name,
+                                           int64_t at_ns,
+                                           xrt_space_relation *out)
+{
+	ControllerDevice *t = static_cast<PlaceholderController *>(xdev)->get_target();
+	if (t == nullptr) {
+		*out = XRT_SPACE_RELATION_ZERO;
+		return XRT_SUCCESS;
+	}
+	return xrt_device_get_tracked_pose(t, name, at_ns, out);
+}
+
+xrt_result_t
+PlaceholderController::get_hand_tracking_cb(
+    xrt_device *xdev, xrt_input_name name, int64_t at_ns, xrt_hand_joint_set *out, int64_t *out_ts)
+{
+	ControllerDevice *t = static_cast<PlaceholderController *>(xdev)->get_target();
+	if (t == nullptr) {
+		out->is_active = false;
+		*out_ts = at_ns;
+		return XRT_SUCCESS;
+	}
+	return xrt_device_get_hand_tracking(t, name, at_ns, out, out_ts);
+}
+
+xrt_result_t
+PlaceholderController::set_output_cb(xrt_device *xdev, xrt_output_name name, const xrt_output_value *value)
+{
+	ControllerDevice *t = static_cast<PlaceholderController *>(xdev)->get_target();
+	if (t == nullptr || t->output_count == 0) {
+		return XRT_SUCCESS;
+	}
+	return xrt_device_set_output(t, name, value);
+}
+
+xrt_result_t
+PlaceholderController::get_battery_status_cb(xrt_device *xdev,
+                                             bool *out_present,
+                                             bool *out_charging,
+                                             float *out_charge)
+{
+	ControllerDevice *t = static_cast<PlaceholderController *>(xdev)->get_target();
+	if (t == nullptr) {
+		*out_present = false;
+		*out_charging = false;
+		*out_charge = 0.0f;
+		return XRT_SUCCESS;
+	}
+	return xrt_device_get_battery_status(t, out_present, out_charging, out_charge);
+}
+
+void
+PlaceholderController::destroy_cb(xrt_device *xdev)
+{
+	auto *self = static_cast<PlaceholderController *>(xdev);
+	{
+		std::lock_guard lk(self->ctx->devices_mut);
+		for (PlaceholderController *&p : self->ctx->placeholder) {
+			if (p == self) {
+				p = nullptr;
+			}
+		}
+	}
+	// The connected controller is not in the system's device list, so it is ours to destroy
+	xrt_device *t = self->target.exchange(nullptr);
+	if (t != nullptr) {
+		xrt_device_destroy(&t);
+	}
+	delete self;
+}
