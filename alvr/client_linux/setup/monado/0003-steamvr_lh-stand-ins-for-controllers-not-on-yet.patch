+void
+Context::bind_placeholder(ControllerDevice *device)
+{
+	std::lock_guard lk(this->devices_mut);
+	if (this->in_setup) {
+		// Still in discovery: the controller goes into the device list itself
+		return;
+	}
+	PlaceholderController *stand_in = nullptr;
+	switch (device->device_type) {
+	case XRT_DEVICE_TYPE_LEFT_HAND_CONTROLLER: stand_in = this->placeholder[XRT_HAND_LEFT]; break;
+	case XRT_DEVICE_TYPE_RIGHT_HAND_CONTROLLER: stand_in = this->placeholder[XRT_HAND_RIGHT]; break;
+	default: break;
+	}
+	if (stand_in == nullptr || !stand_in->bind(device)) {
+		CTX_WARN("Controller %s turned on after setup but there is no free stand-in for its hand; it is ignored",
+		         device->serial);
+	}
+}
