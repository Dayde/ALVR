+/*!
+ * B3-W1 local patch: stand-in for a hand controller that is not on yet when Monado starts.
+ *
+ * The device list and its roles are fixed once the system is created, so a stand-in takes the
+ * controller's place in it. It reports no pose until a controller that turns on later is connected
+ * to it, then passes that controller's poses, inputs, haptics, battery and hand tracking through.
+ */
+class PlaceholderController : public xrt_device
+{
+public:
+	PlaceholderController(const std::shared_ptr<Context> &ctx, xrt_hand hand);
+
+	//! Connect a controller that turned on after setup. Call with `devices_mut` held.
+	bool
+	bind(ControllerDevice *controller);
+
+	const xrt_hand hand;
+
+private:
+	std::shared_ptr<Context> ctx;
+	std::atomic<ControllerDevice *> target{nullptr};
+	std::vector<xrt_input> inputs_vec;
+	//! For each of our inputs, the index of the input with the same name on the target, or -1.
+	std::vector<int> target_index;
+	xrt_output output{};
+
+	ControllerDevice *
+	get_target() const
+	{
+		return target.load(std::memory_order_acquire);
+	}
+
+	static xrt_result_t
+	update_inputs_cb(xrt_device *xdev);
+	static xrt_result_t
+	get_tracked_pose_cb(xrt_device *xdev, xrt_input_name name, int64_t at_ns, xrt_space_relation *out);
+	static xrt_result_t
+	get_hand_tracking_cb(
+	    xrt_device *xdev, xrt_input_name name, int64_t at_ns, xrt_hand_joint_set *out, int64_t *out_ts);
+	static xrt_result_t
+	set_output_cb(xrt_device *xdev, xrt_output_name name, const xrt_output_value *value);
+	static xrt_result_t
+	get_battery_status_cb(xrt_device *xdev, bool *out_present, bool *out_charging, float *out_charge);
+	static void
+	destroy_cb(xrt_device *xdev);
+};
